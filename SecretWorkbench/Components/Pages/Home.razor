@page "/"
@using System.Text.Json
@using SecretWorkbench.Models
@using SecretWorkbench.Services
@inject IUserSecretsService SecretsService
@inject IRecentProjectsStore RecentProjectsStore
@inject SecretWorkbenchOptions ToolOptions

<PageTitle>Secret Workbench</PageTitle>

<header class="utility-bar">
    <div class="brand"><span class="brand-mark" aria-hidden="true">{ }</span><span>Secret Workbench</span></div>
    <div class="utility-meta"><RadzenIcon Icon="lock" aria-hidden="true" /><span>Local workspace</span></div>
</header>

<section class="workbench">
    <aside class="project-panel" aria-label="Project browser" data-project-sidebar>
        <div class="sidebar-resizer" onpointerdown="window.secretWorkbenchSidebar.startResize(event)" ondblclick="window.secretWorkbenchSidebar.reset()" title="Drag to resize; double-click to reset" aria-hidden="true"></div>
        <div class="panel-heading">
            <div><p class="eyebrow">Project index</p><h1>Projects</h1></div>
            <div class="panel-heading-actions">
                <div class="view-switcher" role="group" aria-label="Project view">
                    <RadzenButton Icon="view_list" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" class="@(ProjectView == ProjectViewMode.List ? "is-active" : null)" Click="() => ProjectView = ProjectViewMode.List" title="List view" />
                    <RadzenButton Icon="account_tree" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" class="@(ProjectView == ProjectViewMode.Tree ? "is-active" : null)" Click="() => ProjectView = ProjectViewMode.Tree" title="Folder tree view" />
                </div>
                <RadzenBadge Text="@AllProjectsCount.ToString()" BadgeStyle="BadgeStyle.Light" />
            </div>
        </div>

        <label for="root-path">Workspace folder</label>
        <div class="path-row">
            <input id="root-path" class="rz-textbox" @bind="RootPath" @bind:event="oninput" placeholder="/path/to/solution" />
            <RadzenButton Icon="search" Text="Scan" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined" Click="ScanAsync" IsBusy="IsBusy" />
        </div>
        <p class="helper">Finds up to @DotNetUserSecretsService.MaximumProjects projects (@ProjectFile.SupportedExtensionsForDisplay), nearest first. Build and source-control folders are skipped.</p>

        <div class="project-list">
            @if (RecentProjects.Count == 0 && Projects.Count == 0)
            {
                <div class="empty-state"><RadzenIcon Icon="folder_open" /><strong>No projects indexed</strong><p>Scan the workspace folder to get started.</p><RadzenButton Text="Scan folder" Icon="search" Variant="Variant.Text" Click="ScanAsync" /></div>
            }
            @if (RecentProjects.Count > 0)
            {
                <h2 class="project-group-heading">Recent projects</h2>
            }
            @foreach (var project in RecentProjects)
            {
                <button class="project-item @(project == SelectedProject ? "is-selected" : null)" @onclick="() => OpenProjectAsync(project)">
                    <RadzenIcon class="project-icon" Icon="terminal" aria-hidden="true" />
                    <span><strong>@Path.GetFileNameWithoutExtension(project)</strong><small>@ProjectDirectory(project)</small></span>
                </button>
            }
            @if (ScannedProjects.Any())
            {
                <h2 class="project-group-heading">Found in folder</h2>
                @if (ProjectView == ProjectViewMode.List)
                {
                    @foreach (var project in ScannedProjects)
                    {
                        <button class="project-item @(project == SelectedProject ? "is-selected" : null)" @onclick="() => OpenProjectAsync(project)">
                            <RadzenIcon class="project-icon" Icon="terminal" aria-hidden="true" />
                            <span><strong>@Path.GetFileNameWithoutExtension(project)</strong><small>@RelativeProjectPath(project)</small></span>
                        </button>
                    }
                }
                else
                {
                    <ProjectTree Nodes="ProjectTreeNodes" SelectedProject="SelectedProject" ProjectSelected="OpenProjectAsync" IsRoot="true" />
                }
            }
        </div>
    </aside>

    <main class="editor-panel">
        @if (SelectedProject is null)
        {
            <div class="welcome-state">
                <div class="welcome-icon"><RadzenIcon Icon="key" /></div>
                <p class="eyebrow">.NET user secrets</p>
                <h2>Select a project to begin.</h2>
                <p>Choose a compatible project from the index. You can then edit its complete secret set or replace it with nested appsettings-style JSON.</p>
                <div class="privacy-note"><RadzenIcon Icon="verified_user" /><span>Values stay on this machine, in the same user-secrets store the .NET CLI reads.</span></div>
            </div>
        }
        else
        {
            <div class="editor-heading">
                <div><p class="eyebrow">Active project</p><h2>@Path.GetFileNameWithoutExtension(SelectedProject)</h2><p class="project-path">@SelectedProject</p></div>
                <div class="editor-actions">
                    <RadzenButton Text="Add secret" Icon="add" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined" Click="AddEntry" Disabled="IsBusy" />
                    <RadzenButton Text="Save changes" BusyText="Saving…" Icon="save" ButtonStyle="ButtonStyle.Primary" Click="SaveAsync" Disabled="@(!CanSave || IsBusy)" IsBusy="IsSaving" />
                </div>
            </div>

            <div class="editor-meta"><span>@Entries.Count secret@(Entries.Count == 1 ? string.Empty : "s")</span><span class="change-state @(CurrentFingerprint == OriginalFingerprint ? null : "is-dirty")">@ChangeSummary</span></div>

            @if (!string.IsNullOrWhiteSpace(StatusMessage))
            {
                @if (HasError)
                {
                    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter" role="status">@StatusMessage</RadzenAlert>
                }
                else
                {
                    <RadzenAlert AlertStyle="AlertStyle.Success" Variant="Variant.Flat" Shade="Shade.Lighter" role="status">@StatusMessage</RadzenAlert>
                }
            }

            <div class="table-tools">
                <div class="filter-field"><RadzenIcon Icon="filter_list" /><RadzenTextBox @bind-Value="Filter" Immediate="true" Placeholder="Filter keys…" aria-label="Filter secrets" /></div>
                <RadzenButton Text="@(ShowJson ? "Close JSON" : "Paste JSON")" Icon="data_object" Variant="Variant.Text" ButtonStyle="ButtonStyle.Secondary" Click="ToggleJson" />
            </div>

            @if (ShowJson)
            {
                <RadzenCard class="json-import" Variant="Variant.Outlined">
                    <div class="json-heading"><div><p class="eyebrow">Bulk import</p><h3>Paste appsettings JSON</h3></div><RadzenIcon Icon="data_object" /></div>
                    <RadzenTextArea id="json-input" @bind-Value="JsonInput" Rows="9" Placeholder='{"ConnectionStrings":{"Main":"…"}}' aria-label="appsettings-style JSON" />
                    <p class="helper">Nested objects and arrays are flattened to colon-delimited configuration keys. Importing replaces the complete editor contents.</p>
                    <div><RadzenButton Text="Replace editor from JSON" Icon="swap_horiz" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined" Click="ImportJson" /></div>
                </RadzenCard>
            }

            <div class="secret-table" role="table" aria-label="Project secrets">
                <div class="secret-row secret-header" role="row"><span>Key</span><span>Value</span><span>Actions</span></div>
                @foreach (var entry in FilteredEntries)
                {
                    <div class="secret-row" role="row">
                        <label><span class="mobile-label">Key</span><RadzenTextBox @bind-Value="entry.Key" Immediate="true" Placeholder="Section:Key" aria-label="Secret key" /></label>
                        <label><span class="mobile-label">Value</span><input type="@(entry.IsRevealed ? "text" : "password")" class="rz-textbox" @bind="entry.Value" @bind:event="oninput" placeholder="Secret value" aria-label="Secret value" /></label>
                        <div class="row-actions">
                            <RadzenButton Icon="@(entry.IsRevealed ? "visibility_off" : "visibility")" Variant="Variant.Text" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="() => entry.IsRevealed = !entry.IsRevealed" aria-label="@(entry.IsRevealed ? "Hide value" : "Reveal value")" />
                            <RadzenButton Icon="delete" Variant="Variant.Text" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="() => RemoveEntry(entry)" aria-label="Remove secret" />
                        </div>
                    </div>
                }
            </div>
        }
    </main>
</section>

<footer class="app-footer"><span><RadzenIcon Icon="info" /> Development secrets are not encrypted.</span><a href="https://learn.microsoft.com/aspnet/core/security/app-secrets" target="_blank" rel="noreferrer">Microsoft guidance <RadzenIcon Icon="open_in_new" /></a></footer>

@code {
    private readonly List<SecretEntry> Entries = [];
    private readonly List<string> Projects = [];
    private readonly List<string> RecentProjects = [];
    private string RootPath { get; set; } = string.Empty;
    private string? SelectedProject { get; set; }
    private string Filter { get; set; } = string.Empty;
    private string JsonInput { get; set; } = "{}";
    private string StatusMessage { get; set; } = string.Empty;
    private bool ShowJson { get; set; }
    private bool IsBusy { get; set; }
    private bool IsSaving { get; set; }
    private bool HasError { get; set; }
    private string OriginalFingerprint { get; set; } = string.Empty;
    private ProjectViewMode ProjectView { get; set; } = ProjectViewMode.List;

    private IEnumerable<SecretEntry> FilteredEntries => string.IsNullOrWhiteSpace(Filter)
        ? Entries
        : Entries.Where(x => x.Key.Contains(Filter, StringComparison.OrdinalIgnoreCase));
    private bool CanSave => Entries.All(x => !string.IsNullOrWhiteSpace(x.Key)) &&
                            Entries.Select(x => x.Key.Trim()).Distinct(StringComparer.OrdinalIgnoreCase).Count() == Entries.Count;
    private string CurrentFingerprint => JsonSerializer.Serialize(Entries.OrderBy(x => x.Key, StringComparer.OrdinalIgnoreCase).Select(x => new[] { x.Key.Trim(), x.Value }));
    private string ChangeSummary => CurrentFingerprint == OriginalFingerprint ? "No unsaved changes" : "Unsaved changes";
    private IEnumerable<string> ScannedProjects => Projects.Where(project => !RecentProjects.Contains(project, StringComparer.OrdinalIgnoreCase));
    private int AllProjectsCount => RecentProjects.Concat(Projects).Distinct(StringComparer.OrdinalIgnoreCase).Count();
    private IReadOnlyList<ProjectTreeNode> ProjectTreeNodes => ProjectTreeBuilder.Build(RootPath, ScannedProjects);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            RootPath = ToolOptions.RootPath;
            await LoadRecentProjectsAsync();
            await ScanAsync();
        }
    }

    private async Task ScanAsync()
    {
        await RunAsync(async () =>
        {
            var scan = await SecretsService.FindProjectsAsync(RootPath);
            Projects.Clear();
            Projects.AddRange(scan.Projects);
            StatusMessage = scan.WasTruncated
                ? $"Showing the first {scan.Projects.Count} projects nearest this folder. Scan a narrower folder to reach the rest."
                : $"Found {scan.Projects.Count} project(s).";
        });
    }

    private async Task OpenProjectAsync(string project)
    {
        await RunAsync(async () =>
        {
            Entries.Clear();
            IReadOnlyDictionary<string, string> secrets;
            try { secrets = await SecretsService.ListAsync(project); }
            catch (UserSecretsNotInitializedException)
            {
                await SecretsService.InitializeAsync(project);
                secrets = await SecretsService.ListAsync(project);
                StatusMessage = "Initialized user secrets for this project.";
            }
            Entries.AddRange(secrets.OrderBy(x => x.Key).Select(x => new SecretEntry { Key = x.Key, Value = x.Value }));
            SelectedProject = project;
            OriginalFingerprint = CurrentFingerprint;
            await RecentProjectsStore.RememberAsync(project);
            await LoadRecentProjectsAsync();
        });
    }

    private void AddEntry() { Entries.Add(new SecretEntry()); StatusMessage = string.Empty; }
    private void RemoveEntry(SecretEntry entry) { Entries.Remove(entry); StatusMessage = "Secret staged for removal. Save to apply."; HasError = false; }
    private void ToggleJson()
    {
        ShowJson = !ShowJson;
        if (ShowJson && CanSave)
        {
            JsonInput = JsonSerializer.Serialize(Entries.ToDictionary(x => x.Key, x => x.Value), new JsonSerializerOptions { WriteIndented = true });
        }
    }

    private void ImportJson()
    {
        try
        {
            var imported = JsonSecretFlattener.Flatten(JsonInput);
            Entries.Clear();
            Entries.AddRange(imported.Select(x => new SecretEntry { Key = x.Key, Value = x.Value }));
            StatusMessage = $"Loaded {Entries.Count} secret(s) into the editor. Save to apply.";
            HasError = false;
            ShowJson = false;
        }
        catch (JsonException ex) { StatusMessage = $"JSON is invalid: {ex.Message}"; HasError = true; }
    }

    private async Task SaveAsync()
    {
        if (SelectedProject is null || !CanSave) return;
        IsSaving = true;
        await RunAsync(async () =>
        {
            var values = Entries.ToDictionary(x => x.Key.Trim(), x => x.Value, StringComparer.OrdinalIgnoreCase);
            await SecretsService.SaveAsync(SelectedProject, values);
            OriginalFingerprint = CurrentFingerprint;
            StatusMessage = $"Saved {values.Count} secret(s).";
        });
        IsSaving = false;
    }

    private async Task RunAsync(Func<Task> action)
    {
        IsBusy = true; HasError = false; StatusMessage = string.Empty;
        try { await action(); }
        catch (Exception ex) { StatusMessage = ex.Message; HasError = true; }
        finally { IsBusy = false; StateHasChanged(); }
    }

    private string RelativeProjectPath(string project) => Path.GetRelativePath(RootPath, project);
    private static string ProjectDirectory(string project) => Path.GetDirectoryName(project) ?? project;

    private async Task LoadRecentProjectsAsync()
    {
        RecentProjects.Clear();
        RecentProjects.AddRange(await RecentProjectsStore.ListAsync());
    }

    private enum ProjectViewMode { List, Tree }
}
