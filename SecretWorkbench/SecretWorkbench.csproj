<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>secret-workbench</ToolCommandName>
    <PackageId>SecretWorkbench</PackageId>
    <Version>0.1.0</Version>
    <Authors>Secret Workbench contributors</Authors>
    <Description>A local GUI for viewing and bulk-editing ASP.NET Core user secrets.</Description>
    <PackageTags>dotnet;aspnetcore;user-secrets;developer-tools</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageOutputPath>../artifacts/packages</PackageOutputPath>
    <PackageProjectUrl>https://github.com/kornect/dotnet-secrets-workbench</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/kornect/dotnet-secrets-workbench</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- Radzen's translated resources are unused: the tool's own UI is English only. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- The tool self-hosts Kestrel; it is never published behind IIS, so skip the web.config stub. -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <UserSecretsId>e26bddde-cc65-4436-867a-76114eec2837</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="Radzen.Blazor" Version="11.2.0" />
  </ItemGroup>

  <!-- SQLitePCLRaw ships a native library for every RID it supports. A tool package is
       RID-agnostic, so all of them are packed for all three target frameworks: 52 MB of a
       72 MB package. Keep the RIDs a .NET developer workstation can actually be. -->
  <PropertyGroup>
    <SqliteRuntimesToKeep>win-x64|win-x86|win-arm64|osx-x64|osx-arm64|linux-x64|linux-arm64|linux-musl-x64|linux-musl-arm64</SqliteRuntimesToKeep>
  </PropertyGroup>

  <Target Name="TrimToolPayload" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <!-- Native SQLite for platforms nobody develops on. RelativePath is separator-agnostic
           so that the trim is not silently skipped on a Windows build agent. -->
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\','/').StartsWith('runtimes/')) AND
                   !$([System.Text.RegularExpressions.Regex]::IsMatch($([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\','/')), 'runtimes/($(SqliteRuntimesToKeep))/'))" />
      <!-- The Development config: the tool always runs standalone in Production. -->
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="'%(ResolvedFileToPublish.RelativePath)' == 'appsettings.Development.json'" />
    </ItemGroup>
  </Target>

</Project>
