<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>secret-workbench</ToolCommandName>
    <PackageId>SecretWorkbench</PackageId>
    <Version>0.1.0</Version>
    <Authors>Secret Workbench contributors</Authors>
    <Description>A local GUI for viewing and bulk-editing ASP.NET Core user secrets.</Description>
    <PackageTags>dotnet;aspnetcore;user-secrets;developer-tools</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageOutputPath>../artifacts/packages</PackageOutputPath>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/kornect/dotnet-secrets-workbench</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
    <Content Update="wwwroot/**/*" Pack="true" PackagePath="tools/net10.0/any/wwwroot/%(RecursiveDir)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>

</Project>
